{
	// Use IntelliSense to learn about possible Node.js debug attributes.
	// Hover to view descriptions of existing attributes.
	// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Debug penoos-runner",
			"type": "lldb",
			"request": "launch",
			"cargo": {
				"args": ["build", "--bin=penoos-runner"],
				"filter": {
					"name": "penoos-runner",
					"kind": "bin"
				}
			},
			"args": [],
			"cwd": "${workspaceFolder}"
		},
		{
			"name": "Debug example: hello_world",
			"type": "lldb",
			"request": "launch",
			"cargo": {
				"args": ["build", "--example=hello_world"],
				"filter": {
					"name": "hello_world",
					"kind": "example"
				}
			},
			"args": [],
			"cwd": "${workspaceFolder}"
		},
		{
			"name": "Debug example: math_service",
			"type": "lldb",
			"request": "launch",
			"cargo": {
				"args": ["build", "--example=math_service"],
				"filter": {
					"name": "math_service",
					"kind": "example"
				}
			},
			"args": [],
			"cwd": "${workspaceFolder}"
		},
		{
			"name": "Debug unit tests (penoos lib)",
			"type": "lldb",
			"request": "launch",
			"cargo": {
				"args": ["test", "--no-run", "--lib"],
				"filter": {
					"name": "penoos",
					"kind": "lib"
				}
			},
			"args": [],
			"cwd": "${workspaceFolder}"
		},
		{
			"name": "Debug single unit test (prompts for name)",
			"type": "lldb",
			"request": "launch",
			"cargo": {
				"args": ["test", "--no-run", "--lib"],
				"filter": {
					"name": "penoos",
					"kind": "lib"
				}
			},
			"args": ["${input:testFilter}", "--exact", "--nocapture"],
			"cwd": "${workspaceFolder}"
		},
		{
			"name": "Attach to running penoos process",
			"type": "lldb",
			"request": "attach",
			"pid": "${command:pickProcess}",
			"sourceLanguages": ["rust"]
		}
	],
	"inputs": [
		{
			"id": "testFilter",
			"type": "promptString",
			"description": "Full test path, for example broker::tests::name",
			"default": ""
		}
	]
}
