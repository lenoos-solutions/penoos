	"penoos-db-service": {
		"prefix": "penoos-db-svc",
		"description": "Penoos DB service",
		"body": [
			"use penoos::{PenoosError, Result, Service};",
			"use serde_json::{json, Value};",
			"use std::sync::{Arc, Mutex};",
			"",
			"/// ${1:Entity} persistence service.",
			"pub fn ${2:entity}_db_service(store: Arc<Mutex<Vec<Value>>>) -> Service {",
			"\tlet list_store = Arc::clone(&store);",
			"\tlet create_store = Arc::clone(&store);",
			"\tService::new(\"${1:entity}\")",
			"\t\t.action(\"list\", move |_ctx| {",
			"\t\t\tlet items = list_store.lock().map_err(|_| PenoosError::ValidationError { message: \"store lock poisoned\".into() })?;",
			"\t\t\tOk(json!(items.clone()))",
			"\t\t})",
			"\t\t.action(\"create\", move |ctx| {",
			"\t\t\tlet item = ctx.params().clone();",
			"\t\t\tcreate_store",
			"\t\t\t\t.lock()",
			"\t\t\t\t.map_err(|_| PenoosError::ValidationError { message: \"store lock poisoned\".into() })?",
			"\t\t\t\t.push(item.clone());",
			"\t\t\tOk(item)",
			"\t\t})",
			"\t\t.started(|| Ok(()))",
			"\t\t.stopped(|| Ok(()))",
			"}",
			"$0"
		]
	},
