#!/bin/sh
# Validates the commit subject against docs/engineering/git-workflow.md.
set -eu

msg_file="$1"
subject="$(head -n 1 "$msg_file")"

case "$subject" in
    "Merge "*|"fixup! "*|"squash! "*|'Revert "'*) exit 0 ;;
esac

types='feat|fix|hotfix|deps|chore|docs|refactor|perf|test|ci|build|style|revert|SEMVER-MINOR|SEMVER-MAJOR'
pattern="^(${types})(\([a-z0-9._/-]+\))?!?: .+"

if ! printf '%s\n' "$subject" | grep -Eq "$pattern"; then
    echo "commit-msg: subject must start with a type from docs/engineering/git-workflow.md" >&2
    echo "  got: $subject" >&2
    echo "  example: feat(broker): add call timeout" >&2
    exit 1
fi

if [ "${#subject}" -gt 512 ]; then
    echo "commit-msg: subject is ${#subject} characters; the limit is 512" >&2
    exit 1
fi
